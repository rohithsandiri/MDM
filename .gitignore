*.o
/agent/build/
/agent/bin/
/server/build/
/server/bin/
/tests/build/

# generated certs/keys — never commit these
/server/certs/*.key
/server/certs/*.crt
/server/certs/*.srl
/server/certs/*.pem
/server/certs/devices/

# agent-side replay-protection state (device-local, not source)
/agent/*.state

*.db
*.db-journal
